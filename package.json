{
  "name": "sayserve",
  "version": "0.1.0",
  "private": true,
  "description": "Say it. We serve it. An AI-assisted takeaway ordering system.",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "npm run dev --workspace @sayserve/api",
    "seed": "npm run seed --workspace @sayserve/api",
    "typecheck": "npm run typecheck --workspace @sayserve/api",
    "test": "npm run test --workspace @sayserve/api",
    "test:unit": "npm run test:unit --workspace @sayserve/api"
  }
}
