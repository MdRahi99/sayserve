{
  "name": "sayserve",
  "version": "0.1.0",
  "private": true,
  "description": "Say it. We serve it. An AI-assisted takeaway ordering system.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @sayserve/api",
    "dev:web": "npm run dev --workspace @sayserve/web",
    "seed": "npm run seed --workspace @sayserve/api",
    "build:web": "npm run build --workspace @sayserve/web",
    "typecheck": "npm run typecheck --workspace @sayserve/api && npm run typecheck --workspace @sayserve/web",
    "test": "npm run test --workspace @sayserve/api",
    "test:unit": "npm run test:unit --workspace @sayserve/api",
    "test:eval": "npm run test:eval --workspace @sayserve/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:api": "npm run build --workspace @sayserve/api",
    "start:api": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}