# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (a free M0 cluster is plenty)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sayserve

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of frontends allowed to call this API
CORS_ORIGIN=http://localhost:3000

# How long a one-click demo sandbox lives before it deletes itself
DEMO_TTL_HOURS=24

# The assistant works without these: the safety gate, the parser and fuzzy
# matching are all local, and they handle most orders. Add them for
# meaning-matching ("something fizzy") and for conversational messages.
# Groq: free tier, no card needed — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Voyage: embeddings — https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Payments are optional. Without a key the card option is hidden and the shop
# takes payment on collection. Test keys from https://dashboard.stripe.com/test
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:5000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer back to
PUBLIC_WEB_URL=http://localhost:3000
